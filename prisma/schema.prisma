generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  OWNER
  ADMIN
  KITCHEN
  WAITER
}

enum OrderStatus {
  PENDING
  COOKING
  READY
  BILLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum Plan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
}

enum SocialPostStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  FAILED
}

// Multi-tenant Restaurant model
model Restaurant {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  email          String          @unique
  phone          String?
  address        String?
  gstNumber      String?
  fssaiLicense   String?
  logo           String?
  isActive       Boolean         @default(true)
  subscription   Subscription?
  users          User[]
  categories     Category[]
  products       Product[]
  tables         Table[]
  orders         Order[]
  inventory      Inventory[]
  settings       Settings?
  dailyPurchases DailyPurchase[]
  customers      Customer[]
  socialAccounts SocialMediaAccount[]
  socialPosts    SocialPost[]
  deletionRequests DataDeletionRequest[]
  offers         Offer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Subscription for each restaurant
model Subscription {
  id               String     @id @default(cuid())
  restaurantId     String     @unique
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan             Plan       @default(FREE)
  status           SubStatus  @default(ACTIVE)
  razorpaySubId    String?    // Razorpay subscription ID
  razorpayPlanId   String?    // Razorpay plan ID
  razorpayCustomerId String?  // Razorpay customer ID
  expiresAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(KITCHEN)
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([restaurantId])
}

model Category {
  id           String      @id @default(cuid())
  name         String
  sortOrder    Int         @default(0)
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Inventory {
  id                String              @id @default(cuid())
  name              String
  quantity          Float
  unit              String
  pricePerUnit      Float
  lowStockThreshold Float               @default(10)
  restaurantId      String
  restaurant        Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products          Product[]
  ingredients       ProductIngredient[]
  logs              InventoryLog[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([restaurantId])
}

model Product {
  id           String              @id @default(cuid())
  name         String
  price        Float
  isVeg        Boolean             @default(true)
  isAvailable  Boolean             @default(true)
  image        String?
  categoryId   String
  category     Category            @relation(fields: [categoryId], references: [id])
  inventoryId  String?
  inventory    Inventory?          @relation(fields: [inventoryId], references: [id])
  restaurantId String
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  ingredients  ProductIngredient[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([categoryId])
  @@index([inventoryId])
  @@index([restaurantId])
}

model Table {
  id           String      @id @default(cuid())
  number       Int
  isActive     Boolean     @default(true)
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId])
}

model Order {
  id            String        @id @default(cuid())
  tableId       String
  table         Table         @relation(fields: [tableId], references: [id])
  guestName     String?       // Optional: guest name for individual billing
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  status        OrderStatus   @default(PENDING)
  totalAmount   Float
  paymentStatus PaymentStatus @default(UNPAID)
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tableId])
  @@index([status])
  @@index([restaurantId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  priceAtTime Float
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Settings {
  id               String     @id @default(cuid())
  cafeName         String     @default("My Restaurant")
  feedbackLink     String?
  taxRate          Float      @default(0)
  // Separate GST fields
  cgst             Float      @default(0)
  sgst             Float      @default(0)

  // Inventory Settings
  inventoryDeduction Boolean    @default(true)

  // Restaurant Details
  address          String?
  phone            String?
  email            String?
  gstin            String?
  fssai            String?
  logo             String?
  gstCertificate   String?
  fssaiCertificate String?

  // WhatsApp Green API
  whatsappEnabled  Boolean    @default(false)
  whatsappInstance String?    // Green API instance ID
  whatsappToken    String?    // Green API token
  whatsappMessage  String     @default("Thank you for visiting {restaurant}! 🙏 Your bill of ₹{amount} has been paid. Visit again!")
  restaurantId     String     @unique
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// Super Admin for platform management (company developers)
model SuperAdmin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Blog posts for SEO content
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   // Short description for listings & meta
  content     String   // Full markdown/HTML content
  coverImage  String?  // Featured image URL
  author      String   @default("Aerobill Team")
  isPublished Boolean  @default(false)
  metaTitle   String?  // Custom SEO title
  metaDesc    String?  // Custom SEO description
  keywords    String?  // Comma-separated keywords
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Connected social media accounts
model SocialMediaAccount {
  id            String         @id @default(cuid())
  platform      SocialPlatform
  accountId     String         // Platform-specific account/page ID
  accountName   String         // Display name (Page name or IG username)
  accessToken   String         // Long-lived access token
  tokenExpiry   DateTime?      // When token expires
  profileImage  String?        // Account profile picture URL
  pageId        String?        // Facebook Page ID (needed for IG posting)
  isActive      Boolean        @default(true)
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([restaurantId, platform, accountId])
  @@index([restaurantId])
}

// Social media posts published from Aerobill
model SocialPost {
  id           String             @id @default(cuid())
  content      String             // Post text/caption
  imageUrl     String?            // Image URL for the post
  platforms    String             // Comma-separated platforms: "FACEBOOK,INSTAGRAM"
  status       SocialPostStatus   @default(DRAFT)
  publishedAt  DateTime?
  platformIds  Json?              // { facebook: "post_id", instagram: "post_id" }
  error        String?            // Error message if failed
  restaurantId String
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([restaurantId])
  @@index([status])
}

// Contact page content (singleton - only one row)
model ContactInfo {
  id          String   @id @default("contact-info")
  email       String   @default("support@aerobill.in")
  phone       String   @default("+91 8736098253")
  whatsapp    String?  @default("+91 8736098253")
  address     String   @default("Bhubaneswar, Odisha, India")
  mapUrl      String?  // Google Maps embed URL
  officeHours String   @default("Mon-Sat: 9AM - 6PM IST")
  facebook    String?
  twitter     String?
  instagram   String?
  linkedin    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================
// INVENTORY MANAGEMENT FEATURES
// =====================================

enum POStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

enum LogType {
  ADDITION
  DEDUCTION
  ADJUSTMENT
  PURCHASE_RECEIVED
  ORDER_DEDUCTION
  WASTAGE
}

// Recipe: Ingredients needed per product
model ProductIngredient {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  quantity     Float     // Amount of inventory item needed per unit of product
  restaurantId String

  @@unique([productId, inventoryId])
  @@index([productId])
  @@index([inventoryId])
}

// =====================================
// MARKETPLACE SYSTEM (Super Admin sells to Restaurants)
// =====================================

// Products listed by Super Admin for restaurants to order
model MarketplaceProduct {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float    // Price per unit
  unit        String   // e.g., "kg", "L", "pcs"
  category    String?  // e.g., "Vegetables", "Spices", "Dairy"
  image       String?
  inStock     Boolean  @default(true)
  minOrder    Int      @default(1)
  items       PurchaseOrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Purchase Order for restaurants ordering from marketplace
model PurchaseOrder {
  id                String              @id @default(cuid())
  orderNumber       String
  status            POStatus            @default(PENDING)
  notes             String?
  totalAmount       Float               @default(0)
  restaurantId      String
  estimatedDelivery DateTime?           // 48 hours from order
  items             PurchaseOrderItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([restaurantId])
  @@index([status])
}

model PurchaseOrderItem {
  id                   String             @id @default(cuid())
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  marketplaceProductId String
  marketplaceProduct   MarketplaceProduct @relation(fields: [marketplaceProductId], references: [id])
  quantity             Int
  unitPrice            Float
  createdAt            DateTime           @default(now())

  @@index([purchaseOrderId])
  @@index([marketplaceProductId])
}

// Inventory activity log for audit trail
model InventoryLog {
  id           String   @id @default(cuid())
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type         LogType
  quantity     Float    // Positive for addition, negative for deduction
  previousQty  Float
  newQty       Float
  reason       String?  // e.g., "Order #123", "Purchase Order #456", "Manual adjustment"
  createdAt    DateTime @default(now())

  @@index([inventoryId])
  @@index([createdAt])
}

// Daily manual purchases (not from marketplace)
model DailyPurchase {
  id           String     @id @default(cuid())
  name         String     // Item name
  quantity     Float      // Quantity purchased
  unit         String     // e.g., "kg", "L", "pcs"
  price        Float      // Total price paid
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@index([createdAt])
}

model Customer {
  id           String      @id @default(cuid())
  name         String
  phone        String
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([restaurantId, phone])
  @@index([restaurantId])
}

// Privacy Policy (Singleton)
model PrivacyPolicy {
  id        String   @id @default("privacy-policy")
  content   String   // Markdown/HTML content
  updatedAt DateTime @updatedAt
}

enum DeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

// Data Deletion Request
model DataDeletionRequest {
  id           String         @id @default(cuid())
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reason       String
  status       DeletionStatus @default(PENDING)
  adminNote    String?        // Note from super admin
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([restaurantId])
  @@index([status])
}

// Offers and Coupons
model Offer {
  id            String        @id @default(cuid())
  name          String
  description   String?
  code          String        @unique // e.g., "WELCOME10"
  discountType  DiscountType  @default(PERCENTAGE) // PERCENTAGE, FIXED
  discountValue Float
  minOrderValue Float         @default(0)
  triggerType   TriggerType   @default(MANUAL) // MANUAL, VISIT_FREQUENCY, ORDER_AMOUNT
  triggerValue  Int           @default(0)      // e.g., 5th visit, or order > 1000
  isActive      Boolean       @default(true)
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([restaurantId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TriggerType {
  MANUAL
  VISIT_FREQUENCY
  ORDER_AMOUNT
}
